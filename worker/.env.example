# ─── LLM backend ─────────────────────────────────────────────────────────────
#
# Option A — Hermes Agent (recommended; runs on this machine)
#   HERMES_BASE_URL=http://localhost:8642/v1
#   HERMES_MODEL=hermes-agent
#   HERMES_API_KEY=your-hermes-api-server-key
#
# Option B — Local Ollama
#   HERMES_BASE_URL=http://localhost:11434/v1
#   HERMES_MODEL=hermes3
#   HERMES_API_KEY=ollama
#
# Option C — OpenAI API (leave HERMES_BASE_URL blank for OpenAI's default host)
#   HERMES_BASE_URL=
#   HERMES_MODEL=gpt-5.5
#   HERMES_API_KEY=sk-...
#
HERMES_BASE_URL=http://localhost:8642/v1
HERMES_MODEL=hermes-agent
HERMES_API_KEY=

# Optional tuning — defaults shown.
# MAX_DOCUMENT_CHARS=40000   # Truncate document text sent to the model
# REQUEST_TIMEOUT=120        # HTTP timeout in seconds for the Hermes call
# MAX_TOKENS=8192            # Maximum tokens the model may generate

# Rate-limit retry — when the Hermes backend returns 429 (too many concurrent
# runs) the worker retries the request automatically.  Delay schedule:
#   TIDY_RETRY_BASE_DELAY × 1.5^(attempt-1): 15 s, 22 s, 34 s, 51 s, 76 s
# Increase TIDY_RETRY_BASE_DELAY if jobs consistently compete with other workers.
# TIDY_RETRY_MAX_ATTEMPTS=6  # Max retries per job before failing
# TIDY_RETRY_BASE_DELAY=15   # Seconds for the first retry delay

# ─── Local OCR (scanned pages) ───────────────────────────────────────────────
# Scanned pages (little/no embedded text) are read with local Tesseract.
# Requires system packages: `sudo apt install tesseract-ocr poppler-utils`.
# If absent, scanned pages are skipped (digital PDFs are unaffected).
# OCR_ENABLED=true            # Set false to force legacy text-only extraction
# OCR_DPI=300                 # Rasterization DPI for OCR (raise for tiny fonts)
# SCANNED_TEXT_THRESHOLD=20   # Below this many chars, a page is treated as scanned

# ─── Tidy-voiced narration (reasoning panel) ─────────────────────────────────
# Each pipeline step is narrated as Tidy talking to the user. Phrasing is
# generated with a small OpenAI model when OPENAI_API_KEY is set; otherwise
# Tidy-voiced static fallbacks are used and no OpenAI calls are made.
# NARRATION_ENABLED=true       # Set false to force static fallbacks
# NARRATION_MODEL=gpt-4o-mini  # Small/fast model for narration
# NARRATION_TIMEOUT=15         # Seconds before a narration call falls back
# NARRATION_MAX_TOKENS=60      # Keep each narrated line short

# ─── Learning loop ───────────────────────────────────────────────────────────
# Corrections are embedded so similar future documents retrieve them as
# few-shot examples. Must match the server's EMBEDDING_MODEL, or stored vectors
# and query vectors will have different dimensionality.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# CORRECTIONS_ENABLED=true       # Set false to parse statelessly
# CORRECTION_TOP_K=3             # Max examples injected per job
# CORRECTION_MIN_SCORE=0.75      # Cosine similarity threshold
# CORRECTION_VENDOR_STRICT=true  # Never borrow another vendor's corrections

# ─── MongoDB (the same database the Ship Queue server uses) ──────────────────
# The worker reads its jobs, the mirrored PDFs (GridFS) and the corrections
# collection directly. Collection names are pinned in mongo_collections.py.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ship-queue

# ─── Ship Queue WebSocket URL ────────────────────────────────────────────────
# The worker supports multiple environment profiles so you can target different
# servers without editing this file:
#
#   python worker.py --env .env.local       → Windows localhost dev server
#   python worker.py --env .env.staging     → staging environment
#   python worker.py --env .env.production  → production environment
#
# To run two instances simultaneously (e.g. local + staging), open two
# terminals and start each with its own --env flag.
#
# LOCAL NETWORK TIP: To connect from Ubuntu to a dev server running on your
# Windows PC, use the Windows machine's LAN IP instead of "localhost":
#   SERVER_WS_URL=ws://192.168.x.x:5000/ws/doc-tidy
# Make sure Windows Firewall allows inbound TCP on port 5000.
#
# Common values:
#   Local dev:  ws://localhost:5000/ws/doc-tidy
#   LAN dev:    ws://192.168.x.x:5000/ws/doc-tidy
#   Staging:    wss://ship-queue.staging.outdoorequippedservice.com/ws/doc-tidy
#   Production: wss://ship-queue.outdoorequippedservice.com/ws/doc-tidy
SERVER_WS_URL=ws://localhost:5000/ws/doc-tidy

# Must match DOC_TIDY_WORKER_TOKEN in the server's .env. The server rejects the
# WebSocket upgrade without it.
DOC_TIDY_WORKER_TOKEN=
