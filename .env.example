PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ship-queue

# Frontend URL (for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Separate callback for the Drive-account picker (allows connecting any Google
# account for Drive, not just the login account). Add this URI to the allowed
# redirect URIs in the Google Cloud Console credentials for the same OAuth client.
DRIVE_CALLBACK_URL=http://localhost:5000/api/auth/drive/callback
# Separate callback for the Doc Tidy shared mailbox. Enable the Gmail API and add
# the gmail.readonly scope to the OAuth consent screen, then add this URI to the
# allowed redirect URIs for the same OAuth client.
DOC_TIDY_CALLBACK_URL=http://localhost:5000/api/auth/doc-tidy/callback
# How often Doc Tidy checks the connected mailbox for mail matching an enabled
# rule. Matches are stored and pushed to open results tables immediately.
# Defaults to 15 seconds; values below 5 are raised to 5.
DOC_TIDY_POLL_INTERVAL_SECONDS=15

# Shared secret the Doc Tidy parsing worker presents when it connects to
# /ws/doc-tidy. Must match DOC_TIDY_WORKER_TOKEN in worker/.env. Without it the
# server rejects every worker connection, so parsing is unavailable.
# Generate one with: openssl rand -hex 32
DOC_TIDY_WORKER_TOKEN=

# Embeddings for the Doc Tidy correction learning loop. Corrections are still
# recorded without a key, they just cannot be retrieved as examples on later
# documents. Must match the worker's EMBEDDING_MODEL, or stored and query
# vectors will have different dimensionality.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Dropbox OAuth (for the Dropbox Fetcher page)
# Create a "scoped" app at https://www.dropbox.com/developers/apps and enable the
# scopes: account_info.read, files.metadata.read, sharing.read, sharing.write.
# Add DROPBOX_CALLBACK_URL below to the app's "Redirect URIs" in the App Console.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_CALLBACK_URL=http://localhost:5000/api/auth/dropbox/callback

# ShipStation API (optional)
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# Background order auto-sync. The server pulls new orders on a schedule even when
# nobody has the app open. These only SEED the initial config on first run —
# afterwards admins manage it from Settings (stored in the DB), so changes take
# effect without a restart.
# AUTO_SYNC_ENABLED: set to "false" to start disabled (default: enabled).
# AUTO_SYNC_INTERVAL_MS: initial interval in ms (default: 300000 = 5 minutes).
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MS=300000

# Packing slip via test label. ShipStation has no API to render a packing slip,
# but a non-billable USPS *test label* under a "… + Packing Slip" label layout
# returns the native packing slip page, which we graft onto the real label.
# testLabel is USPS-only, so a USPS carrier/service is used to mint it. Leave
# blank to auto-discover a connected USPS carrier + domestic service.
SHIPSTATION_TEST_CARRIER_CODE=
SHIPSTATION_TEST_SERVICE_CODE=

# Ship-from origin. Labels use the matching ShipStation warehouse's origin
# address (Ship From) and set advancedOptions.warehouseId.
# Preferred: match by numeric warehouseId (stable if the warehouse is renamed).
# If SHIP_FROM_WAREHOUSE_ID is unset, we match by name (case-insensitive),
# which defaults to "Belleville". Both are optional.
SHIP_FROM_WAREHOUSE_ID=629885
SHIP_FROM_WAREHOUSE_NAME=Belleville

# Fallback ship-from address — only used if the warehouse above can't be
# fetched/found. Company defaults to "Belleville".
SHIP_FROM_NAME=
SHIP_FROM_COMPANY=Belleville
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY=
SHIP_FROM_PHONE=

# Cookie Jar worker (separate process: npm run cookie-jar / cookie-jar:dev).
# COOKIE_JAR_PORT: local health-server port so it does not collide with PORT=5000.
# On Railway the worker service can omit this and use the injected PORT.
COOKIE_JAR_PORT=5001
# Outdoor Equipped US — Sphere cookie API. Token is sent as a raw Authorization
# header (not Bearer). Sphere serves HTTP :80 only (HTTPS :443 is refused).
COOKIE_JAR_OE_US_TOKEN=
# COOKIE_JAR_OE_US_URL=http://sphere.outdoorequippedservice.com/api/v1/cookie/provide/seller-central-oe-us

# Helly Hansen Sportswear B2B only (ASAPSPORT / b2bsport.hellyhansen.com).
# These env vars do not apply to Workwear. Catalog and account defaults match
# Order Swift. Cookie is a session — never commit it. Prefer Dropship (B2B) →
# brand → Configurations, or Cookie Jar helly-hansen-sports-b2b / helly-hansen-work-b2b:
# HH_B2B_COOKIE=
# HH_B2B_BASE_URL=https://b2bsport.hellyhansen.com
# HH_B2B_CATALOG=ASAPSPORT
# HH_B2B_ACCOUNT_ID=9014876
# HH_B2B_ARRIVE_ON=2026-09-16

# NOTE: Google Drive uploads reuse the Google OAuth login above with an added
# Drive scope. The OAuth consent screen should be configured as "Internal"
# (Google Workspace) so the broad Drive scope does not require app verification.
